# ============================================================
# Acuity Invest — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# Server
PORT=3001
NODE_ENV=development

# JWT — REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_A_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS

# Frontend URL — REQUIRED in production (used for CORS origin)
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_PATH=./data/acuity.db

# Google Gemini AI — REQUIRED for AI insights
GEMINI_API_KEY=your-gemini-api-key-here

# Langfuse Observability (optional — leave empty to disable)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASEURL=http://localhost:3000

# Seed user configuration (used by: npm run seed)
SEED_USER_EMAIL=demo@acuityinvest.com
SEED_USER_PASSWORD=Demo@12345
SEED_USER_NAME=Demo User
