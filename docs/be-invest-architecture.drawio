        <!-- Key Principles Box -->
        <mxCell id="principles" value="Key Architectural Principles&#xa;&#xa;✓ Deterministic Fee Math (No LLM arithmetic)&#xa;✓ LLM-as-Judge (Independent validation)&#xa;✓ Pluggable LLM Dispatcher (4 providers)&#xa;✓ File-based Persistence (JSON/JSONL)&#xa;✓ Cache-First (7-day LLM, 24-hour news)&#xa;✓ @observe() on all endpoints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;fontStyle=1" vertex="1" parent="1">
