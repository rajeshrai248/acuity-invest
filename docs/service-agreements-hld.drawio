        </mxCell>
        
        <mxCell id="note2" value="• ONEPAM: Centralized master data management for parties, products, and permissions with three dedicated APIs" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;spacingLeft=5;" vertex="1" parent="1">
