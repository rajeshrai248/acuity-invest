        <mxCell id="note1" value="• IRIS (Assisted Channel): Employee-facing interface for initiating service agreement workflows" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;spacingLeft=5;" vertex="1" parent="1">
