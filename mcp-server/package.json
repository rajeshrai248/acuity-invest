{
  "name": "acuity-invest-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Acuity Invest portfolio data",
  "main": "dist/mcp-server/src/index.js",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=8192' ts-node src/index.ts",
    "dev:stdio": "NODE_OPTIONS='--max-old-space-size=8192' ts-node src/stdio.ts",
    "build": "NODE_OPTIONS='--max-old-space-size=8192' tsc",
